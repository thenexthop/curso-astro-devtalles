generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id    String  @id @db.VarChar
  title String? @db.VarChar
  likes Int     @default(0)
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model client {
  id        String  @id(map: "client_pk") @db.Uuid
  name      String  @db.VarChar
  age       Int?    @default(0)
  is_active Boolean @default(true)
}

model product {
  id            String          @id @default(uuid())
  description   String?         @db.VarChar(250)
  gender        String?         @db.VarChar(80)
  price         Float           @db.Real
  sizes         String?         @db.VarChar(100)
  slug          String          @unique @db.VarChar(250)
  stock         Int?
  tags          String?         @db.VarChar(250)
  title         String?         @db.VarChar(250)
  type          String?         @db.VarChar(150)
  user_id       String?
  user          user?           @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_product_user")
  product_image product_image[]
}

model product_image {
  id         String   @id @default(uuid())
  image      String?  @db.VarChar(250)
  product_id String?  @db.Uuid
  product    product? @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_image_pid")
}

model role {
  id   String @id @db.Uuid
  name String @db.VarChar(80)
}

model session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model user {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  account       account[]
  product       product[]
  session       session[]
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime

  @@index([identifier])
}
