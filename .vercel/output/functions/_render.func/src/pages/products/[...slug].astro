---
import { actions } from "astro:actions";
import MainLayout from "@/layouts/MainLayout.astro";
import ProductSlideShow from "@/components/products/ProductSlideShow.astro";

export const prerender = false;

const { slug } = Astro.params;

const { data: product, error } = await Astro.callAction(
    actions.getProductBySlug,
    slug ?? "",
);

if (error) {
    console.log(error);
    return Astro.redirect("/404");
}

const images = product.product_image.map((image) => image.image ?? "");
---

<!-- description={product.description || ""}
image={images[0] || ""} -->
<MainLayout title={product.title ?? ""}>
    <div class="grid grid-cols-1 md:grid-cols-3 w-full gap-4">
        <ProductSlideShow images={images} />

        <section>
            <h2 class="text-2xl font-bold">{product.title}</h2>
            <h2 class="font-bold">${product.price}</h2>

            <h3 class="mt-5">Tallas</h3>
            <ul class="size-listing flex gap-3">
                {
                    product.sizes
                        ?.split(",")
                        .map((size) => <li data-size={size}>{size}</li>)
                }
            </ul>

            <h3 class="mt-5">Cantidad</h3>
            <div>
                <button class="decrease btn-quantity">-</button>
                <input id="quantity" type="number" min="1" value="1" />
                <button class="increase btn-quantity">+</button>
            </div>

            <button
                class="btn-add-to-cart mt-5 bg-blue-500 text-white p-3 w-full"
                >Añadir al carrito</button
            >

            <h3 class="mt-10">Descripción</h3>
            <p>{product.description}</p>
        </section>
    </div>

    <input type="hidden" id="product-id" value={product.id} />
</MainLayout>

<script>
    //const sizeElements = document.querySelectorAll("li");
    const sizeListings = document.querySelector(
        ".size-listing",
    ) as HTMLUListElement;
    const quantity = document.querySelector("#quantity") as HTMLInputElement;
    const increase = document.querySelector(".increase") as HTMLButtonElement;
    const decrease = document.querySelector(".decrease") as HTMLButtonElement;
    const addToCartBtn = document.querySelector(
        ".btn-add-to-cart",
    ) as HTMLButtonElement;

    increase.addEventListener("click", () => {
        quantity.value = Math.min(Number(quantity.value) + 1, 5).toString();
    });

    decrease.addEventListener("click", () => {
        quantity.value = Math.max(Number(quantity.value) - 1, 1).toString();
    });

    sizeListings.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;

        // Retorna si el elemento no es un li
        if (target.tagName !== "LI") return;

        document.querySelectorAll(".size-listing li").forEach((li) => {
            li.classList.remove("selected-size");
        });

        target.classList.add("selected-size");
        // console.log(size);
    });

    addToCartBtn.addEventListener("click", () => {
        const productId = document.getElementById(
            "product-id",
        ) as HTMLInputElement;
        const size = document.querySelector(".selected-size") as HTMLLIElement;
        const quantity = document.querySelector(
            "#quantity",
        ) as HTMLInputElement;

        const sizeSelected = size?.dataset?.size ?? "";

        if (!sizeSelected) {
            console.error(
                "Debe seleccionar una talla para agregar el producto al carrito",
            );
            alert(
                "Por favor, seleccione la talla que desea agregar al carrito.",
            );
            return;
        }

        if (!productId.value || !quantity.value) {
            console.error(
                "Ocurrió un error al intentar añadir el producto al carrito",
            );
            alert(
                "Por favor, seleccione la cantidad que desea agregar al carrito.",
            );
            return;
        }

        addToCartBtn.disabled = true;
        addToCartBtn.textContent = "Añadiendo al carrito...";

        const product = {
            id: productId.value,
            size: sizeSelected,
            quantity: Number(quantity.value),
        };

        console.log("addToCartBtn: ", product);

        addToCartBtn.disabled = false;
        addToCartBtn.textContent = "Añadir al carrito";
    });
</script>

<style is:inline>
    h3 {
        font-weight: bold;
    }

    li {
        cursor: pointer;
        padding: 4px;
        margin-left: 2px;
        user-select: none;

        &:hover {
            text-decoration: underline;
        }
    }

    .selected-size {
        background-color: rgb(1, 114, 189);
        color: white;
        padding: 4px;
        border-radius: 2px;
        text-decoration: underline;
        font-weight: bold;
        transition: all;
    }

    .btn-quantity {
        width: 25px;
        text-align: center;
        padding: 2px;
        cursor: pointer;

        &:hover {
            background-color: rgb(146, 146, 146);
            border: 1px solid gray;
        }
    }

    input {
        width: 16;
        text-align: center;
        padding: 2;
        border: 1;
        border-color: gray;
    }

    input[type="number"]::-webkit-outer-spin-button,
    input[type="number"]::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    input[type="number"] {
        -moz-appearance: textfield; /* Para Firefox */
    }
</style>
