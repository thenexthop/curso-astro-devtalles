---
import { SignedIn, SignedOut } from "@clerk/astro/components";
import MainLayout from "../layouts/MainLayout.astro";

export const prerender = false;
---

<MainLayout>
    <SignedOut>
        <p class="text-xl text-red-500 text-center">
            Esta página es solo para usuarios autenticados, por favor inicia
            sesión para continuar.
        </p>
    </SignedOut>
    <SignedIn>
        <h2 class="text-2xl font-bold">Bienvenido a su página protegida!</h2>
        <p>Contenido exclusivo para usuarios autenticados.</p>
    </SignedIn>
</MainLayout>
