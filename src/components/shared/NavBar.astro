---
const links = [
    { href: "/", label: "Listado" },
    { href: "/pokemons/1", label: "Paginado" },
    { href: "/favorites", label: "Favoritos" },
    { href: "/islands", label: "Islas" },
    { href: "/transitions", label: "Transiciones" },
];

const currentPathname = Astro.url.pathname;
---

<nav class="shadow bg-gray-800 mb-3">
    <div
        class="container flex items-center justify-center px-6 py-4 mx-auto text-gray-300 font-semibold"
    >
        <!-- {
            links.map(({ href, label }) => (
                <a href={href} class:list={[
                        " hover:text-gray-100 mx-1.5 sm:mx-6",
                        { "border-b-2 text-gray-100 border-blue-500": currentPathname === href },
                   ]}> 
                   {label}
                </a>) 
            )
        } -->
        {
            links.map(({ href, label }) => (
                <div>
                    <a
                        href={href}
                        class="text-gray-300 hover:text-gray-100 mx-1.5 sm:mx-6"
                    >
                        {label}
                    </a>
                    {currentPathname === href ? (
                        <div
                            transition:name="menu-line"
                            class="border-b-2 border-blue-500 mx-4"
                        />
                    ) : (
                        <div class="border-b-2 border-transparent" />
                    )}
                </div>
            ))
        }
    </div>
</nav>
