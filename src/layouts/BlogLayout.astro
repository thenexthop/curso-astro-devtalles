---
import { ClientRouter } from "astro:transitions";

import "@/styles/global.css";

interface Props {
	title?: string;
}

const { title = "My First Astro Blog" } = Astro.props;
// const { title="My First Astro Blog", ...rest } = Astro.props
// const frontmatter = rest.frontmatter
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body class="bg-gray-950 min-h-screen">
		<a href="/" id="btn-back">Regresar</a>

		<main class="mb-6 max-w-5xl mx-auto p-2">
			<slot />
		</main>
	</body>
</html>
