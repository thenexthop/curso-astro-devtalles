---
import { getCollection } from "astro:content";
import { siteConfig } from "@/config/site-config";
import AuthorCard from "@/components/AuthorCard.astro";
import MainLayout from "@/layouts/MainLayout.astro";

const authors = await getCollection("author");
---

<MainLayout title="Listado de autores">
    <section class="container p-4 mx-auto">
        <h1 class="mb-2">{siteConfig.title}</h1>
        <a href="/">Regresar</a>
    </section>

    <section class="grid grid-cols-1 sm:grid-cols-2 gap-8 p-4 mx-auto">
        {authors.map((author) => <AuthorCard author={author} />)}
    </section>
</MainLayout>
