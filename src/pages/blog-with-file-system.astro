---
import MainLayout from "@/layouts/MainLayout.astro"
import BlogPost from "@/components/BlogPost.astro"
import { siteConfig } from "@/config/site-config"


//const posts = await Astro.glob("./posts/*.{md,mdx}") // Este esta deprecado ya en Astro 5
const posts:any[]  = Object.values(import.meta.glob("./posts-old/*.{md,mdx}", {eager: true}))


---

<MainLayout title="Mi primer Blog en Astro (Sección 05)">
	<!-- component -->
<section class="bg-gray-950">
    <div class="container px-6 py-10 mx-auto">
        <h1 class="capitalize lg:text-4x">
			{ siteConfig.title }
		</h1>

        <div class="grid grid-cols-1 gap-8 mt-8 md:mt-16 md:grid-cols-2">

            {
                posts.map((post) => <BlogPost {...post} />)

            }

            
            
        </div>
    </div>
</section>
</MainLayout>