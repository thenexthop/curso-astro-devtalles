---
import { server } from "../actions";
import MainLayout from "../layouts/MainLayout.astro";
import PlaceCard from "../components/PlaceCard.astro";

const { data: places = [], error } = await Astro.callAction(
	server.getPlaces,
	{},
);

if (error) {
	console.log(error);
}

// console.log("Desde el servidor: ", places);
---

<MainLayout>
	<h1 class="text-3xl font-bold">Lugares</h1>
	<div class="grid grid-cols-3 gap-4 mt-4">
		{places.map((place) => <PlaceCard place={place} />)}
	</div>
</MainLayout>
