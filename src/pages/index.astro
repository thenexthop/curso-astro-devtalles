---
import MainLayout from '@/layouts/MainLayout.astro'
import Title from '@/components/shared/Title.astro'
import PokemonCard from '@/components/pokemons/PokemonCard.astro'
import type { PokemonListResponse } from '@/interfaces/pokemon-list.response.ts'

const response = await fetch('https://pokeapi.co/api/v2/pokemon')
const { results } = await response.json() as PokemonListResponse
---

<MainLayout title="Pokemon Static | Home page (Devtalles)">
	<div class="px-6 py-2">
		<Title>Listado de Pokemons</Title>
	</div>
	<section class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-6 p-6">
		{
		results.map((pokemon) => (
			<PokemonCard name={pokemon.name} url={pokemon.url} />
		))
	}
	</section>

</MainLayout>

