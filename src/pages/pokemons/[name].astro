---
import type { GetStaticPaths } from "astro";
import MainLayout from "@/layouts/MainLayout.astro";
import Title from "@/components/shared/Title.astro";
import PokemonCard from "@/components/pokemons/PokemonCard.astro";
import type { PokemonListResponse } from "@/interfaces/pokemon-list.response";
import { Icon } from "astro-icon/components";

export const getStaticPaths = (async () => {
    const response = await fetch("https://pokeapi.co/api/v2/pokemon?limit=151");
    const { results } = (await response.json()) as PokemonListResponse;

    return results.map(({ name, url }) => ({
        params: { name },
        props: { name, url },
    }));

    // return [
    //     {
    //         params: { name: "bulbasaur" },
    //         props: { name: "bulbasaur", url: `https://pokeapi.co/api/v2/pokemon/1/`}
    //     },
    //     {
    //         params: { name: "charmander" },
    //         props: { name: "charmander", url: `https://pokeapi.co/api/v2/pokemon/4/`}
    //     },
    //     {
    //         params: { name: "raticate" },
    //         props: { name: "raticate", url: `https://pokeapi.co/api/v2/pokemon/20/`}
    //     },
    // ]
}) satisfies GetStaticPaths;

const { name } = Astro.params;
const { url } = Astro.props;

const id = url.split("/").at(-2);
const audioSrc = `https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/${id}.ogg`;
---

<MainLayout title={`Pokemon: ${name}`}>
    <section class="mt-10 mx-8 flex flex-col justify-center items-center">
        <div>
            <div class="flex gap-2">
                <div>
                    <button
                        onclick="history.back()"
                        class="text-blue-500 hover:underline hover:cursor-pointer mb-3"
                        >← Regresar</button
                    >
                    <Title>{name}</Title>
                </div>
                <button
                    id="btn-favorite"
                    data-name={name}
                    data-id={id}
                    class="self-end hover:animate-pulse hover:cursor-pointer"
                >
                    <Icon
                        data-light
                        name="heart-light"
                        class="mb-1"
                        size={40}
                    />
                    <Icon
                        data-fill
                        name="heart-fill"
                        class="hidden mb-1"
                        size={40}
                    />
                </button>
            </div>
        </div>
        <PokemonCard name={name} url={url} isBig />
        <audio controls class="mt-4">
            <source src={audioSrc} type="audio/ogg" />
            Your browser does not support the audio element.
        </audio>
    </section>
</MainLayout>
<style>
    a {
        color: #3b82f6;
        margin-bottom: 8px;
        display: inline-block;

        &:hover {
            text-decoration: underline;
        }
    }
</style>
<script>
    import type { FavoritePokemon } from "@/interfaces/favorite-pokemon";
    const handlePageLoad = () => {
        let favoritePokemos: FavoritePokemon[] = JSON.parse(
            localStorage.getItem("favorites") ?? "[]",
        );
        //console.log(favoritePokemos);

        const btnFavorite = document.getElementById(
            "btn-favorite",
        ) as HTMLButtonElement;

        if (!btnFavorite) return;

        const name = btnFavorite.dataset.name!;
        const id = btnFavorite.dataset.id!;
        const heartFillIcon = btnFavorite.querySelector(
            `[data-fill]`,
        ) as HTMLElement;
        const heartLightIcon = btnFavorite.querySelector(
            `[data-light]`,
        ) as HTMLElement;

        const initFavorites = () => {
            let favoritePokemos: FavoritePokemon[] = JSON.parse(
                localStorage.getItem("favorites") ?? "[]",
            );

            const isFavorite = favoritePokemos.some(
                (pokemon) => pokemon.name === name,
            );

            if (isFavorite) {
                // Pintar el corazon
                heartFillIcon.classList.remove("hidden");
                heartLightIcon.classList.add("hidden");
            }
        };

        initFavorites();

        const toggleFavorite = () => {
            const isFavorite = favoritePokemos.some(
                (pokemon) => pokemon.name === name,
            );

            if (isFavorite) {
                // Remover de la lista de favoritos
                favoritePokemos = favoritePokemos.filter(
                    (pokemon) => pokemon.name !== name,
                );
            } else {
                //Lo agregamos
                favoritePokemos.push({ id: +id, name });
            }

            localStorage.setItem("favorites", JSON.stringify(favoritePokemos));
        };

        btnFavorite.addEventListener("click", () => {
            heartFillIcon.classList.toggle("hidden");
            heartLightIcon.classList.toggle("hidden");

            toggleFavorite();

            //console.log({ name, id });
        });
    };

    document.addEventListener("astro:page-load", handlePageLoad);
</script>
